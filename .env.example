# 配置示例：复制本文件为 .env 后填写真实值。
# 注意：.env 已被 .gitignore 忽略，切勿把真实密钥提交到源码仓库。

# ---------- 模型服务（必填，用于真实分析） ----------
# 模型服务商提供的 API 密钥
LLM_API_KEY=

# 接口基础地址（OpenAI 兼容），程序会自动拼接 /chat/completions
# 常见示例：
#   DeepSeek        https://api.deepseek.com/v1
#   Moonshot(Kimi)  https://api.moonshot.cn/v1
#   智谱 GLM        https://open.bigmodel.cn/api/paas/v4
#   通义千问        https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI          https://api.openai.com/v1
LLM_BASE_URL=

# 模型名
#   DeepSeek        deepseek-chat
#   Moonshot(Kimi)  moonshot-v1-8k
#   智谱 GLM        glm-4-flash
#   通义千问        qwen-plus
#   OpenAI          gpt-4o-mini
LLM_MODEL=

# 请求超时秒数（可选，默认 60）
LLM_TIMEOUT=60

# 结构化输出能力：prompt（默认、兼容性最好）/ json_object / json_schema
# 根据所用服务商支持情况显式选择，不会静默降级。
LLM_RESPONSE_FORMAT=prompt
# 可选：按每百万 token 的单价估算费用，留空时显示“未计量”
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
LLM_CURRENCY=CNY

# ---------- 输入上限（可选） ----------
# 单条材料的字符数上限（默认 50000）
MAX_SOURCE_LENGTH=50000
# 单次分析的材料总长度上限（默认 200000）
MAX_TOTAL_SOURCE_LENGTH=200000

# ---------- 请求限额（可选） ----------
# 每用户 60 秒内分析类请求上限（默认 20）
RATE_LIMIT_MAX=20
# 注册与登录合计：每来源 IP 每分钟上限
AUTH_RATE_LIMIT_MAX=20
# HTTP 请求体字节上限（包含 JSON 编码开销）
MAX_BODY_BYTES=2000000
# 同域部署无需 CORS；跨域时填写允许的完整来源，以英文逗号分隔
CORS_ORIGINS=

# ---------- 会话与数据库（可选） ----------
# 登录会话有效期（小时，默认 168 = 7 天）
SESSION_TTL_HOURS=168
# SQLite 数据库路径（默认项目根目录 app.db）
# DB_PATH=/app/app.db
# 备份目录默认位于数据库目录下的 backups
# BACKUP_DIR=/data/backups

# 默认正式业务模式，示例结果不参与真实项目分析。
# 培训环境需要时显式启用；培训入口为 /?training=1
ENABLE_DEMO_MODE=false
